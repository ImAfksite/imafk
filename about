    <!-- ==========================================================================
         WATER RIPPLES, HYPER-INTERACTIVE KOI & AURA LOGIC
         ========================================================================== -->
    <script>
        /* --------------------------------------------------------------------------
           1. WATER SIMULATION WITH ZOOMIES KOI & FRENZY FEEDING
           -------------------------------------------------------------------------- */
        const canvas = document.getElementById('water-canvas');
        const ctx = canvas.getContext('2d');
        let width, height;

        function resizeCanvas() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        const mouse = { x: width / 2, y: height / 2 };
        let ripples = [];
        let foods = [];
        let isZoomies = false;

        window.addEventListener('pointermove', (e) => {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
            if (Math.random() < 0.25) addRipple(mouse.x, mouse.y, 16, 0.25);
        });

        window.addEventListener('pointerdown', (e) => {
            addRipple(e.clientX, e.clientY, 35, 0.6);
            foods.push({ x: e.clientX, y: e.clientY, life: 180 });
        });

        function addRipple(x, y, maxR, alpha) {
            ripples.push({ x, y, r: 0, maxR: maxR || 35, alpha: alpha || 0.4 });
        }

        class KoiFish {
            constructor() {
                this.x = Math.random() * width;
                this.y = Math.random() * height;
                this.targetX = this.x;
                this.targetY = this.y;
                this.angle = Math.random() * Math.PI * 2;
                this.baseSpeed = 1.4 + Math.random() * 1.2;
                this.speed = this.baseSpeed;
                this.length = 44 + Math.random() * 16;
                this.segments = 9;
                this.spine = [];
                for (let i = 0; i < this.segments; i++) {
                    this.spine.push({ x: this.x, y: this.y });
                }
                this.wiggle = Math.random() * Math.PI * 2;
                this.colorType = Math.random();
            }

            update() {
                this.speed = isZoomies ? this.baseSpeed * 3.4 : this.baseSpeed;

                // Target food or wander wildly
                if (foods.length > 0) {
                    this.targetX = foods[0].x;
                    this.targetY = foods[0].y;
                    if (Math.hypot(this.x - foods[0].x, this.y - foods[0].y) < 18) {
                        foods[0].life -= 25;
                        addRipple(this.x, this.y, 24, 0.5);
                    }
                } else if (Math.random() < (isZoomies ? 0.08 : 0.02) || Math.hypot(this.x - this.targetX, this.y - this.targetY) < 40) {
                    this.targetX = Math.random() * width;
                    this.targetY = Math.random() * height;
                }

                const targetAngle = Math.atan2(this.targetY - this.y, this.targetX - this.x);
                let diff = targetAngle - this.angle;
                while (diff < -Math.PI) diff += Math.PI * 2;
                while (diff > Math.PI) diff -= Math.PI * 2;
                this.angle += diff * (isZoomies ? 0.1 : 0.04);

                this.x += Math.cos(this.angle) * this.speed;
                this.y += Math.sin(this.angle) * this.speed;
                this.wiggle += this.speed * 0.2;

                // Spine follow-through
                this.spine[0] = { x: this.x, y: this.y };
                const segDist = this.length / this.segments;
                for (let i = 1; i < this.segments; i++) {
                    const prev = this.spine[i - 1];
                    const curr = this.spine[i];
                    const dx = curr.x - prev.x;
                    const dy = curr.y - prev.y;
                    const d = Math.hypot(dx, dy) || 1;
                    curr.x = prev.x + (dx / d) * segDist;
                    curr.y = prev.y + (dy / d) * segDist;
                }

                if (Math.random() < (isZoomies ? 0.2 : 0.03)) {
                    addRipple(this.x, this.y, isZoomies ? 28 : 14, isZoomies ? 0.35 : 0.15);
                }
            }

            draw() {
                const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                let bodyColor, finColor;

                if (this.colorType > 0.5) {
                    bodyColor = isDark ? (isZoomies ? '#38E1A6' : 'rgba(56, 225, 166, 0.75)') : 'rgba(23, 107, 82, 0.75)';
                    finColor = isDark ? 'rgba(56, 225, 166, 0.35)' : 'rgba(23, 107, 82, 0.25)';
                } else {
                    bodyColor = isDark ? (isZoomies ? '#F59E0B' : 'rgba(245, 158, 11, 0.8)') : 'rgba(217, 119, 6, 0.75)';
                    finColor = isDark ? 'rgba(245, 158, 11, 0.35)' : 'rgba(217, 119, 6, 0.25)';
                }

                ctx.save();
                if (isZoomies) {
                    ctx.shadowBlur = 14;
                    ctx.shadowColor = bodyColor;
                }

                // Tapered body
                for (let i = 0; i < this.segments - 1; i++) {
                    const p1 = this.spine[i];
                    const p2 = this.spine[i + 1];
                    const widthFactor = Math.sin((i / this.segments) * Math.PI) * (this.length * 0.22);

                    ctx.strokeStyle = bodyColor;
                    ctx.lineWidth = Math.max(2, widthFactor);
                    ctx.lineCap = 'round';
                    ctx.beginPath();
                    ctx.moveTo(p1.x, p1.y);
                    ctx.lineTo(p2.x, p2.y);
                    ctx.stroke();
                }

                // Head
                ctx.fillStyle = bodyColor;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.length * 0.14, 0, Math.PI * 2);
                ctx.fill();

                // Dorsal & tail fins
                const tail = this.spine[this.segments - 1];
                const tailWiggle = Math.sin(this.wiggle * 1.3) * (isZoomies ? 14 : 7);
                ctx.fillStyle = finColor;
                ctx.beginPath();
                ctx.ellipse(tail.x, tail.y, this.length * 0.26, this.length * 0.09, this.angle + tailWiggle * 0.08, 0, Math.PI * 2);
                ctx.fill();

                ctx.restore();
            }
        }

        const fishes = [];
        for (let i = 0; i < 8; i++) {
            fishes.push(new KoiFish());
        }

        function toggleZoomies() {
            isZoomies = !isZoomies;
            const btn = document.getElementById('zoomies-btn');
            if (isZoomies) {
                btn.classList.add('btn-primary');
                btn.classList.remove('btn-glass');
                btn.innerHTML = `<span>🔥 ZOOMIES ACTIVE</span>`;
                addAuraBurst(null, '🐟 FISH WENT SICKO MODE');
            } else {
                btn.classList.remove('btn-primary');
                btn.classList.add('btn-glass');
                btn.innerHTML = `<span>⚡ Zoomies Mode</span>`;
            }
        }

        function dropMegaFood(e) {
            for (let i = 0; i < 18; i++) {
                const fx = width / 2 + (Math.random() - 0.5) * 240;
                const fy = height / 2 + (Math.random() - 0.5) * 180;
                foods.push({ x: fx, y: fy, life: 260 });
                addRipple(fx, fy, 28, 0.45);
            }
            addAuraBurst(e, '+5,000 FISH AURA');
        }

        function renderWater() {
            ctx.clearRect(0, 0, width, height);
            const isDark = document.documentElement.getAttribute('data-theme') === 'dark';

            // Ripples
            for (let i = ripples.length - 1; i >= 0; i--) {
                const r = ripples[i];
                r.r += isZoomies ? 1.6 : 0.9;
                r.alpha -= 0.007;

                if (r.alpha <= 0 || r.r >= r.maxR) {
                    ripples.splice(i, 1);
                    continue;
                }

                ctx.strokeStyle = isDark ? `rgba(56, 225, 166, ${r.alpha * 0.6})` : `rgba(23, 107, 82, ${r.alpha * 0.5})`;
                ctx.lineWidth = 1.2;
                ctx.beginPath();
                ctx.arc(r.x, r.y, r.r, 0, Math.PI * 2);
                ctx.stroke();
            }

            // Pellets
            for (let i = foods.length - 1; i >= 0; i--) {
                const f = foods[i];
                f.life--;
                if (f.life <= 0) {
                    foods.splice(i, 1);
                    continue;
                }
                ctx.fillStyle = isDark ? '#38E1A6' : '#D97706';
                ctx.beginPath();
                ctx.arc(f.x, f.y, 2.5, 0, Math.PI * 2);
                ctx.fill();
            }

            fishes.forEach(fish => {
                fish.update();
                fish.draw();
            });

            requestAnimationFrame(renderWater);
        }
        renderWater();

        /* --------------------------------------------------------------------------
           2. ISLAND POP-OUT ANIMATION FROM DEAD CENTER
           -------------------------------------------------------------------------- */
        const popItems = [
            { id: 'nav-item', delay: '0.08s' },
            { id: 'origin-item', delay: '0.16s' },
            { id: 'terminal-item', delay: '0.24s' },
            { id: 'sloth-item', delay: '0.32s' },
            { id: 'toy-item', delay: '0.40s' },
            { id: 'brainrot-item', delay: '0.48s' },
            { id: 'footer-item', delay: '0.54s' }
        ];

        function calculateCenterTrajectories() {
            const centerX = window.innerWidth / 2;
            const centerY = window.innerHeight / 2;

            popItems.forEach(item => {
                const el = document.getElementById(item.id);
                if (!el) return;

                const rect = el.getBoundingClientRect();
                const itemCenterX = rect.left + rect.width / 2;
                const itemCenterY = rect.top + rect.height / 2;

                const dx = centerX - itemCenterX;
                const dy = centerY - itemCenterY;

                el.style.setProperty('--dx', `${dx}px`);
                el.style.setProperty('--dy', `${dy}px`);
                el.style.setProperty('--delay', item.delay);
            });
        }

        function triggerPopOutSequence() {
            const shockwave = document.getElementById('shockwave');
            shockwave.classList.remove('shockwave-active');
            void shockwave.offsetWidth;
            shockwave.classList.add('shockwave-active');

            addRipple(window.innerWidth / 2, window.innerHeight / 2, 130, 0.85);

            calculateCenterTrajectories();
            document.body.classList.add('system-ejected');
        }

        function replayPopOutSequence() {
            document.body.classList.remove('system-ejected');
            setTimeout(() => {
                triggerPopOutSequence();
            }, 600);
        }

        window.addEventListener('load', () => {
            calculateCenterTrajectories();
            setTimeout(triggerPopOutSequence, 450);
        });

        window.addEventListener('resize', () => {
            if (!document.body.classList.contains('system-ejected')) {
                calculateCenterTrajectories();
            }
        });

        /* --------------------------------------------------------------------------
           3. GEN ALPHA BRAINROT YAP GENERATOR
           -------------------------------------------------------------------------- */
        const yaps = [
            "\"Erm, what the sigma? Who let bro cook this entire website?\"",
            "\"Chat, Baby Gronk just fanum taxed my homework while I was feeding the fish.\"",
            "\"Bro is edging his screentime limit just to watch 2D koi fish swim in circles.\"",
            "\"Bro really coded multi-layer liquid glass refraction instead of studying for the math exam.\"",
            "\"+1,000,000 AURA: You locked in on the about page and completely ignored real life.\"",
            "\"Kai Cenat reacted to this website and lost all his aura in Ohio.\"",
            "\"Bro is mewing in silence at 3:00 AM inspecting CSS box-shadows.\""
        ];
        let yapIdx = 0;

        function rollBrainrot() {
            yapIdx = (yapIdx + 1) % yaps.length;
            const textEl = document.getElementById('brainrot-quote');
            textEl.style.opacity = '0';
            setTimeout(() => {
                textEl.textContent = yaps[yapIdx];
                textEl.style.opacity = '1';
            }, 180);
        }

        function copyBrainrot(btn) {
            const text = document.getElementById('brainrot-quote').textContent;
            navigator.clipboard.writeText(text);
            const original = btn.textContent;
            btn.textContent = "✅ Copied Yap!";
            setTimeout(() => btn.textContent = original, 1800);
        }

        function cookMoreBrainrot() {
            const logs = document.querySelector('.terminal-logs');
            const funnyLines = [
                "🔥 Fanum Tax level: 100% Critical",
                "💀 Bro is so cooked on god",
                "🗿 Mewing streak: +10,000 Aura",
                "🚨 Kai Cenat detected in sector 4",
                "⚡ GigaChad protocol initialized"
            ];
            const newLog = document.createElement('div');
            newLog.style.color = '#38E1A6';
            newLog.textContent = `➜ [YAP]: ${funnyLines[Math.floor(Math.random() * funnyLines.length)]}`;
            logs.appendChild(newLog);
            if (logs.children.length > 7) logs.removeChild(logs.children[0]);
        }

        /* --------------------------------------------------------------------------
           4. AURA METER LOGIC
           -------------------------------------------------------------------------- */
        const auraTiers = [
            { max: 20, score: "-50,000 AURA", text: "\"Studying for an exam right now (L rizz, extremely cooked).\"" },
            { max: 50, score: "+10,000 AURA", text: "\"Watching Subway Surfers gameplay while reading this paragraph.\"" },
            { max: 80, score: "+50,000 AURA", text: "\"Playing mini-games on mute during a Zoom call (Sigma grindset).\"" },
            { max: 99, score: "+90,000 AURA", text: "\"Avoided all chores, mewing in dark mode, feeding digital fish.\"" },
            { max: 100, score: "+999,999 AURA", text: "\"ASCENDED RIZZLER: You have unlocked the infinite Ohio Sigma aura.\"" }
        ];

        function updateAuraMeter(val) {
            document.getElementById('aura-fill').style.width = `${val}%`;
            const tier = auraTiers.find(t => val <= t.max) || auraTiers[auraTiers.length - 1];
            document.getElementById('aura-score').textContent = tier.score;
            document.getElementById('aura-verdict').textContent = tier.text;
        }

        /* --------------------------------------------------------------------------
           5. FLOATING AURA POPUP BURST
           -------------------------------------------------------------------------- */
        function addAuraBurst(e, text) {
            const el = document.createElement('div');
            el.className = 'floating-aura';
            el.textContent = text || '+1,000 AURA';

            const x = e ? e.clientX : window.innerWidth / 2;
            const y = e ? e.clientY : window.innerHeight / 2;
            el.style.left = `${x}px`;
            el.style.top = `${y}px`;

            document.body.appendChild(el);
            setTimeout(() => el.remove(), 900);
        }

        /* --------------------------------------------------------------------------
           6. THEME TOGGLE
           -------------------------------------------------------------------------- */
        function toggleTheme() {
            const current = document.documentElement.getAttribute('data-theme') || 'dark';
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('afk_theme', next);
        }

        const savedTheme = localStorage.getItem('afk_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
    </script>
</body>
