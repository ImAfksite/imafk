        <!-- 2. UNIQUE GEN-ALPHA BRAINROT ARCHIVE -->
        <main class="content-wrap">
            <div class="holo-grid">
                
                <!-- Tile 1: Bro Didn't Lock In (The Origin Lore) -->
                <article class="island origin-island pop-item" id="origin-item">
