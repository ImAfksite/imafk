<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ORBIT SWITCH</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Kanit:wght@400;800&display=swap');

        body {
            margin: 0;
            overflow: hidden;
            background-color: #F0F2E9;
            font-family: 'Kanit', sans-serif;
            color: #2D2D2D;
            user-select: none;
        }

        #ui-layer {
            position: absolute;
            inset: 0;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 10;
        }

        /* --- HUD --- */
        #score-board {
            position: absolute;
            top: 20px;
            right: 30px;
            font-size: 30px;
            font-weight: 800;
            z-index: 5;
        }

        /* --- START SCREEN --- */
        #start-screen {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between; 
            align-items: center;
            padding: 60px 20px;
            background: radial-gradient(circle, transparent 40%, rgba(240, 242, 233, 0.9) 90%);
            pointer-events: auto;
        }

        .header { text-align: center; }
        .footer { text-align: center; width: 100%; max-width: 400px; padding-bottom: 20px; }

        h1 {
            font-size: 80px;
            margin: 0;
            line-height: 0.9;
            letter-spacing: -4px;
            text-transform: uppercase;
            color: #2D2D2D;
        }

        p {
            font-size: 16px;
            letter-spacing: 4px;
            margin-top: 10px;
            color: #FF6B6B;
            font-weight: 800;
            text-transform: uppercase;
        }

        /* --- MODALS --- */
        #info-screen, #game-over-screen, #leaderboard-screen {
            position: absolute;
            pointer-events: auto;
            text-align: center;
            background: #F0F2E9;
            padding: 40px;
            border: 4px solid #2D2D2D;
            box-shadow: 10px 10px 0px #2D2D2D;
            max-width: 400px;
            width: 90%;
            z-index: 20;
        }

        #leaderboard-screen h3 {
            margin: 0 0 20px 0;
            text-transform: uppercase;
            font-size: 30px;
            border-bottom: 4px solid #2D2D2D;
            padding-bottom: 10px;
        }

        #leaderboard-list {
            list-style: none;
            padding: 0;
            margin: 0 0 30px 0;
            text-align: left;
            font-size: 20px;
        }

        #leaderboard-list li {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-weight: 800;
            color: #555;
            border-bottom: 1px dashed #ccc;
            padding-bottom: 4px;
        }

        #leaderboard-list li:first-child {
            color: #FF6B6B;
            font-size: 24px;
        }

        #info-screen ul { text-align: left; margin-bottom: 30px; font-size: 18px; line-height: 1.5; padding-left: 20px;}

        /* --- LOADING BAR --- */
        #loading-bar-container { width: 100%; margin-bottom: 20px; }
        #loading-text { font-size: 12px; letter-spacing: 2px; margin-bottom: 5px; text-align: left; }
        #loading-bar { width: 100%; height: 10px; background: #D1D5DB; position: relative; }
        #progress { width: 0%; height: 100%; background: #2D2D2D; transition: width 0.2s; }

        /* --- BUTTONS --- */
        #menu-buttons {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        button {
            background: #2D2D2D;
            color: #F0F2E9;
            border: none;
            padding: 20px 40px;
            font-size: 24px;
            font-family: 'Kanit', sans-serif;
            font-weight: 800;
            cursor: pointer;
            box-shadow: 5px 5px 0px #FF6B6B;
            transition: transform 0.1s;
        }

        button.secondary {
            padding: 20px;
            background: #4ECDC4;
            box-shadow: 5px 5px 0px #2D2D2D;
        }

        button:hover { transform: translate(-2px, -2px); box-shadow: 8px 8px 0px #FF6B6B; }
        button:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0px #FF6B6B; }

        .hidden { display: none !important; }
        canvas { display: block; }
    </style>
</head>
<body>

<div id="ui-layer">
    <div id="score-board" class="hidden">Score: <span id="score">0</span></div>
    
    <!-- Start Screen -->
    <div id="start-screen">
        <div class="header">
            <h1>ORBIT SWITCH</h1>
            <p>SYSTEM AUTO-PILOT ENGAGED</p>
        </div>

        <div class="footer">
            <div id="loading-bar-container">
                <div id="loading-text">CALIBRATING ORBIT...</div>
                <div id="loading-bar"><div id="progress"></div></div>
            </div>
            
            <div id="menu-buttons" class="hidden">
                <button id="start-btn">LAUNCH</button>
                <button id="rank-btn" class="secondary">🏆</button>
                <button id="info-btn" class="secondary">?</button>
            </div>
        </div>
    </div>

    <!-- Leaderboard -->
    <div id="leaderboard-screen" class="hidden">
        <h3>GLOBAL TOP 5</h3>
        <ul id="leaderboard-list"></ul>
        <button id="close-rank-btn">CLOSE</button>
    </div>

    <!-- Info -->
    <div id="info-screen" class="hidden">
        <h2>HOW TO PLAY</h2>
        <ul>
            <li><strong>TAP / SPACE</strong> to switch orbit direction.</li>
            <li><strong>RED SQUARES</strong> will destroy you.</li>
            <li><strong>YELLOW TRIANGLES</strong> give +10 points.</li>
            <li><strong>TIP:</strong> The game speeds up every 10 points.</li>
        </ul>
        <button id="close-info-btn">UNDERSTOOD!</button>
    </div>

    <!-- Game Over -->
    <div id="game-over-screen" class="hidden">
        <h1>GAME OVER</h1>
        <p>Final Score: <span id="final-score">0</span></p>
        <p id="high-score-msg" class="hidden">NEW HIGH SCORE!</p>
        <button id="restart-btn">RETRY MISSION</button>
    </div>
</div>

<canvas id="gameCanvas"></canvas>

<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');

    // UI Elements
    const scoreBoard = document.getElementById('score-board');
    const scoreEl = document.getElementById('score');
    const finalScoreEl = document.getElementById('final-score');
    const startScreen = document.getElementById('start-screen');
    const gameOverScreen = document.getElementById('game-over-screen');
    const infoScreen = document.getElementById('info-screen');
    const leaderboardScreen = document.getElementById('leaderboard-screen');
    const highScoreMsg = document.getElementById('high-score-msg');

    // Buttons
    const startBtn = document.getElementById('start-btn');
    const restartBtn = document.getElementById('restart-btn');
    const infoBtn = document.getElementById('info-btn');
    const closeInfoBtn = document.getElementById('close-info-btn');
    const rankBtn = document.getElementById('rank-btn');
    const closeRankBtn = document.getElementById('close-rank-btn');

    // Loading & Leaderboard
    const loadingContainer = document.getElementById('loading-bar-container');
    const loadingBar = document.getElementById('progress');
    const loadingText = document.getElementById('loading-text');
    const menuButtons = document.getElementById('menu-buttons');
    const leaderboardList = document.getElementById('leaderboard-list');

    let width, height, centerX, centerY;
    let particles = [];
    let enemies = [];
    let coins = [];
    let score = 0;
    let gameRunning = false;
    let isDemoMode = true; 
    let frameCount = 0;
    let difficultyMultiplier = 1;
    let animationId; 

    const FAKE_SCORES = [
        { name: "VOID_WALKER", score: 1201 },
        { name: "PIXEL_HUNT", score: 673 },
        { name: "JS_NINJA", score: 520 },
        { name: "ORBIT_GOD", score: 113 },
        { name: "ROOKIE_01", score: 56 }
    ];

    const COLORS = {
        bg: '#F0F2E9',
        player: '#4ECDC4',
        enemy: '#FF6B6B',
        coin: '#FFE66D',
        dark: '#2D2D2D'
    };

    const PLAYER = {
        radius: 12,
        orbitRadius: 120,
        angle: 0,
        speed: 0.05,
        direction: 1 
    };

    function resize() {
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = width;
        canvas.height = height;
        centerX = width / 2;
        centerY = height / 2;
    }
    window.addEventListener('resize', resize);

    function generateLeaderboard() {
        leaderboardList.innerHTML = '';
        FAKE_SCORES.forEach((entry, index) => {
            const li = document.createElement('li');
            li.innerHTML = `<span>#${index+1} ${entry.name}</span> <span>${entry.score}</span>`;
            leaderboardList.appendChild(li);
        });
    }

    function switchDirection() {
        if (isDemoMode && gameRunning === false) return;
        PLAYER.direction *= -1;
        createParticles(getPlayerX(), getPlayerY(), COLORS.player, 3);
    }

    document.addEventListener('mousedown', (e) => {
        if(e.target.tagName !== 'BUTTON') switchDirection();
    });
    document.addEventListener('keydown', (e) => {
        if (e.code === 'Space') switchDirection();
    });
    document.addEventListener('touchstart', (e) => {
        if(e.target.tagName !== 'BUTTON') { e.preventDefault(); switchDirection(); }
    }, {passive: false});

    class Enemy {
        constructor() {
            this.angle = Math.random() * Math.PI * 2;
            this.distance = 0;
            this.speed = 2 + (Math.random() * 1.5) + (difficultyMultiplier * 0.5);
            this.size = 15;
            this.active = true;
        }
        update() {
            this.distance += this.speed;
            if (Math.abs(this.distance - PLAYER.orbitRadius) < (this.size + PLAYER.radius)) {
                let pAngle = (PLAYER.angle % (Math.PI * 2));
                if (pAngle < 0) pAngle += Math.PI * 2;
                let diff = Math.abs(pAngle - this.angle);
                if (diff > Math.PI) diff = (Math.PI * 2) - diff;

                if (diff < 0.15) { 
                    if (!isDemoMode) gameOver();
                    else {
                        this.active = false; 
                        createParticles(getPlayerX(), getPlayerY(), COLORS.enemy, 5);
                    }
                }
            }
            if (this.distance > Math.max(width, height)) {
                this.active = false;
                if(!isDemoMode) {
                    score++;
                    scoreEl.innerText = score;
                }
            }
        }
        draw() {
            const x = centerX + Math.cos(this.angle) * this.distance;
            const y = centerY + Math.sin(this.angle) * this.distance;
            ctx.save();
            ctx.translate(x, y);
            ctx.rotate(this.angle);
            ctx.fillStyle = COLORS.enemy;
            ctx.fillRect(-this.size/2, -this.size/2, this.size, this.size);
            ctx.restore();
        }
    }

    class Coin {
        constructor() {
            this.angle = Math.random() * Math.PI * 2;
            this.distance = PLAYER.orbitRadius;
            this.size = 10;
            this.active = true;
            this.spawnTime = Date.now();
        }
        update() {
            let pAngle = (PLAYER.angle % (Math.PI * 2));
            if (pAngle < 0) pAngle += Math.PI * 2;
            let diff = Math.abs(pAngle - this.angle);
            if (diff > Math.PI) diff = (Math.PI * 2) - diff;

            if (diff < 0.1) {
                this.active = false;
                if(!isDemoMode) {
                    score += 10;
                    scoreEl.innerText = score;
                }
                createParticles(centerX + Math.cos(this.angle)*this.distance, centerY + Math.sin(this.angle)*this.distance, COLORS.coin, 8);
            }
            if (Date.now() - this.spawnTime > 5000) this.active = false;
        }
        draw() {
            const x = centerX + Math.cos(this.angle) * this.distance;
            const y = centerY + Math.sin(this.angle) * this.distance;
            ctx.beginPath();
            ctx.moveTo(x, y - this.size);
            ctx.lineTo(x + this.size, y + this.size);
            ctx.lineTo(x - this.size, y + this.size);
            ctx.fillStyle = COLORS.coin;
            ctx.fill();
        }
    }

    class Particle {
        constructor(x, y, color) {
            this.x = x; this.y = y; this.color = color;
            this.size = Math.random() * 5 + 2;
            this.speedX = (Math.random() - 0.5) * 5;
            this.speedY = (Math.random() - 0.5) * 5;
            this.life = 1;
        }
        update() {
            this.x += this.speedX; this.y += this.speedY;
            this.life -= 0.05; this.size *= 0.9;
        }
        draw() {
            ctx.globalAlpha = this.life;
            ctx.fillStyle = this.color;
            ctx.fillRect(this.x, this.y, this.size, this.size);
            ctx.globalAlpha = 1;
        }
    }

    function createParticles(x, y, color, count) {
        for(let i=0; i<count; i++) particles.push(new Particle(x, y, color));
    }
    function getPlayerX() { return centerX + Math.cos(PLAYER.angle) * PLAYER.orbitRadius; }
    function getPlayerY() { return centerY + Math.sin(PLAYER.angle) * PLAYER.orbitRadius; }

    function runBot() {
        let danger = false;
        enemies.forEach(e => {
            let distToOrbit = PLAYER.orbitRadius - e.distance;
            if (distToOrbit < 60 && distToOrbit > 0) {
                let pAngle = (PLAYER.angle % (Math.PI * 2));
                if (pAngle < 0) pAngle += Math.PI * 2;
                let diff = e.angle - pAngle;
                if (diff > Math.PI) diff -= Math.PI * 2;
                if (diff < -Math.PI) diff += Math.PI * 2;
                if ((PLAYER.direction === 1 && diff > 0 && diff < 1) || 
                    (PLAYER.direction === -1 && diff < 0 && diff > -1)) {
                    danger = true;
                }
            }
        });
        if (danger) {
            PLAYER.direction *= -1;
            createParticles(getPlayerX(), getPlayerY(), COLORS.player, 2);
        }
    }

    function gameLoop() {
        ctx.clearRect(0, 0, width, height);
        
        ctx.beginPath();
        ctx.arc(centerX, centerY, PLAYER.orbitRadius, 0, Math.PI * 2);
        ctx.strokeStyle = '#D1D5DB';
        ctx.lineWidth = 4;
        ctx.stroke();

        if (isDemoMode) runBot();
        else scoreBoard.classList.remove('hidden');

        PLAYER.angle += PLAYER.speed * PLAYER.direction;
        
        const px = getPlayerX();
        const py = getPlayerY();
        ctx.beginPath();
        ctx.arc(px, py, PLAYER.radius, 0, Math.PI * 2);
        ctx.fillStyle = COLORS.player;
        ctx.fill();
        
        ctx.beginPath();
        ctx.arc(px - (Math.cos(PLAYER.angle)*10*PLAYER.direction), py - (Math.sin(PLAYER.angle)*10*PLAYER.direction), PLAYER.radius * 0.6, 0, Math.PI*2);
        ctx.fillStyle = 'rgba(78, 205, 196, 0.5)';
        ctx.fill();

        frameCount++;
        if (frameCount % (60 - Math.min(50, Math.floor(score/5))) === 0) enemies.push(new Enemy());
        if (frameCount % 180 === 0) coins.push(new Coin());
        
        difficultyMultiplier = 1 + (score * 0.01);

        enemies.forEach(e => { e.update(); e.draw(); });
        enemies = enemies.filter(e => e.active);
        coins.forEach(c => { c.update(); c.draw(); });
        coins = coins.filter(c => c.active);
        particles.forEach(p => { p.update(); p.draw(); });
        particles = particles.filter(p => p.life > 0);

        if (gameRunning || isDemoMode) {
            animationId = requestAnimationFrame(gameLoop);
        }
    }

    function gameOver() {
        gameRunning = false;
        cancelAnimationFrame(animationId);
        
        createParticles(getPlayerX(), getPlayerY(), COLORS.player, 20);
        finalScoreEl.innerText = score;
        
        if(score > FAKE_SCORES[0].score) {
            highScoreMsg.classList.remove('hidden');
            highScoreMsg.innerText = `NEW RECORD! YOU BEAT ${FAKE_SCORES[0].name}`;
        } else {
            highScoreMsg.classList.add('hidden');
        }

        gameOverScreen.classList.remove('hidden');
        scoreBoard.classList.add('hidden');
    }

    function startGame() {
        cancelAnimationFrame(animationId);
        
        isDemoMode = false;
        score = 0;
        scoreEl.innerText = '0';
        enemies = [];
        coins = [];
        particles = [];
        PLAYER.angle = 0;
        PLAYER.direction = 1;
        gameRunning = true;
        
        startScreen.classList.add('hidden');
        gameOverScreen.classList.add('hidden');
        infoScreen.classList.add('hidden');
        leaderboardScreen.classList.add('hidden');
        
        gameLoop();
    }

    function runLoadingSequence() {
        let progress = 0;
        const interval = setInterval(() => {
            progress += 1;
            loadingBar.style.width = progress + '%';
            
            if(progress < 30) loadingText.innerText = "CALIBRATING ORBIT...";
            else if (progress < 60) loadingText.innerText = "SCANNING FOR HOSTILES...";
            else if (progress < 90) loadingText.innerText = "SYNCHRONIZING SYSTEMS...";
            
            if (progress >= 100) {
                clearInterval(interval);
                loadingText.innerText = "SYSTEM READY";
                loadingContainer.classList.add('hidden');
                menuButtons.classList.remove('hidden');
            }
        }, 30); 
    }

    infoBtn.addEventListener('click', () => infoScreen.classList.remove('hidden'));
    closeInfoBtn.addEventListener('click', () => infoScreen.classList.add('hidden'));
    rankBtn.addEventListener('click', () => leaderboardScreen.classList.remove('hidden'));
    closeRankBtn.addEventListener('click', () => leaderboardScreen.classList.add('hidden'));
    startBtn.addEventListener('click', startGame);
    restartBtn.addEventListener('click', startGame);

    resize();
    generateLeaderboard();
    runLoadingSequence(); 
    gameLoop();
</script>

</body>
</html>
